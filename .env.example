# Server-only Prisma connection string. Never expose this as NEXT_PUBLIC_*.
# For Supabase pooled runtime connections, use the transaction pooler URL.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true&connection_limit=1"
# Optional direct connection for Prisma CLI migrations/introspection only.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<direct-host>:5432/postgres"
# Beta admin API gate; keep server-only and never expose as NEXT_PUBLIC_*.
MASFAH_ADMIN_API_TOKEN="replace-with-a-long-random-token"
# Optional encrypted export key; keep server-only.
MASFAH_BACKUP_KEY="replace-with-a-long-random-key"
# Runtime binding and canonical host; never expose as NEXT_PUBLIC_*.
APP_PORT="3000"
APP_HOST="127.0.0.1"
CANONICAL_HOST="msaffah.ae"
# Optional comma-separated allowed hostnames for deployment validation.
ALLOWED_HOSTS="msaffah.ae,mosaffah.ae,icad.ae"
