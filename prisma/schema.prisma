// MASFAH data model: taxonomy and capabilities are data, not code.

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// A location tree supports Musaffah, M zones, ICAD and future cities/zones.
model Location {
  id          String             @id @default(uuid())
  nameEn      String
  nameAr      String
  slug        String             @unique
  kind        String             // CITY, AREA, ZONE
  parentId    String?
  parent      Location?          @relation("LocationTree", fields: [parentId], references: [id])
  children    Location[]         @relation("LocationTree")
  businesses  BusinessLocation[]
  suggestions TaxonomySuggestion[]
  isActive    Boolean            @default(true)
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([kind, isActive])
}

// One table supports categories, subcategories, activities, item types,
// conditions, intents, services, products, languages, capabilities and tags.
model Taxonomy {
  id             String                   @id @default(uuid())
  kind           String                   // CATEGORY, SUBCATEGORY, ACTIVITY, ITEM_TYPE, CONDITION, USER_INTENT, SERVICE, PRODUCT, LANGUAGE, CAPABILITY, TAG
  nameEn         String
  nameAr         String
  slug           String
  parentId       String?
  parent         Taxonomy?                @relation("TaxonomyTree", fields: [parentId], references: [id])
  children       Taxonomy[]               @relation("TaxonomyTree")
  aliases        TaxonomyAlias[]
  assignments    BusinessTaxonomy[]
  suggestions    TaxonomySuggestion[]
  isOther        Boolean                  @default(false)
  isActive       Boolean                  @default(true)
  sortOrder      Int                      @default(0)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@unique([kind, slug])
  @@index([kind, isActive])
  @@index([parentId])
}

model TaxonomyAlias {
  id         String   @id @default(uuid())
  taxonomyId String
  taxonomy   Taxonomy @relation(fields: [taxonomyId], references: [id], onDelete: Cascade)
  value      String
  locale     String   @default("en")

  @@unique([taxonomyId, value, locale])
  @@index([value])
}

model TaxonomySuggestion {
  id                 String    @id @default(uuid())
  kind               String
  nameEn             String
  nameAr             String?
  sourceText         String?
  submittedBy        String?
  locationId         String?
  location           Location? @relation(fields: [locationId], references: [id])
  matchedTaxonomyId  String?
  matchedTaxonomy    Taxonomy? @relation(fields: [matchedTaxonomyId], references: [id])
  status             String    @default("PENDING") // PENDING, APPROVED, EDITED, REJECTED, MERGED
  reviewerNote       String?
  reviewedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status, kind])
}

model Business {
  id              String               @id @default(uuid())
  nameEn          String
  nameAr          String
  slug            String               @unique
  descriptionEn   String?
  descriptionAr   String?
  isVerified      Boolean              @default(false)
  tier            String               @default("FREE")
  listingType     String               @default("ORGANIC") // ORGANIC, FEATURED, SPONSORED
  publicationStatus String             @default("DRAFT") // DRAFT, PENDING_REVIEW, PUBLISHED, REJECTED
  isSearchable    Boolean              @default(false)
  rating          Float                @default(0.0)
  reviewCount     Int                  @default(0)
  phone           String
  whatsapp        String?
  openingHours    Json?
  priceLevel      Int                  @default(1)
  latitude        Float?
  longitude       Float?
  locations       BusinessLocation[]
  taxonomies      BusinessTaxonomy[]
  photos          Photo[]
  quotes          QuoteResponse[]
  reviews         Review[]
  claims          BusinessClaim[]
  projects        BusinessProject[]
  updates         BusinessUpdate[]
  mediaAssets     BusinessMediaAsset[]
  mediaReports    BusinessMediaReport[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model BusinessLocation {
  businessId String
  locationId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  isPrimary  Boolean  @default(false)

  @@id([businessId, locationId])
  @@index([locationId])
}

model BusinessTaxonomy {
  businessId  String
  taxonomyId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  taxonomy    Taxonomy @relation(fields: [taxonomyId], references: [id], onDelete: Cascade)
  source      String   @default("ADMIN") // ADMIN, CLAIMED, IMPORTED

  @@id([businessId, taxonomyId])
  @@index([taxonomyId])
}

model Photo {
  id         String   @id @default(uuid())
  url        String
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sortOrder  Int      @default(0)
}

model Review {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  rating     Int
  text       String?
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
}

model BusinessClaim {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  claimantId String
  status     String   @default("PENDING")
  evidence   Json?
  createdAt  DateTime @default(now())
  reviewedAt DateTime?
}

model QuoteRequest {
  id             String          @id @default(uuid())
  userId         String?
  contactName    String?
  contactPhone   String?
  contactEmail   String?
  requirement    String
  parsedIntent   Json?
  photoUrl       String?
  locationId     String?
  status         String          @default("PENDING")
  responses      QuoteResponse[]
  whatsappLinks  QuoteRequestLink[]
  createdAt      DateTime        @default(now())
}

model QuoteResponse {
  id              String        @id @default(uuid())
  quoteRequestId  String
  quoteRequest    QuoteRequest  @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  businessId      String
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  price           Float?
  availability    String?
  message         String?
  photoUrl        String?
  estimatedTime   String?
  createdAt       DateTime      @default(now())
}

// Future-ready WhatsApp Business Platform integration. No provider is active
// until a server-side webhook and credentials are explicitly configured.
model WhatsappAccount {
  id                  String               @id @default(uuid())
  provider            String               @default("META_WHATSAPP_CLOUD_API")
  displayPhoneNumber  String?
  phoneNumberId       String?              @unique
  businessAccountId   String?
  secretRef           String?              // Reference to a secret manager entry; never the token itself.
  status              String               @default("DISABLED") // DISABLED, CONFIGURED, ACTIVE, SUSPENDED
  conversations       WhatsappConversation[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model WhatsappContact {
  id                  String               @id @default(uuid())
  waId                String               @unique
  displayName         String?
  phoneE164           String?
  locale              String?
  consentStatus       String               @default("UNKNOWN") // UNKNOWN, OPTED_IN, OPTED_OUT
  consentAt           DateTime?
  lastSeenAt          DateTime?
  conversations       WhatsappConversation[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model WhatsappConversation {
  id                  String               @id @default(uuid())
  accountId           String
  contactId           String
  account             WhatsappAccount      @relation(fields: [accountId], references: [id])
  contact             WhatsappContact      @relation(fields: [contactId], references: [id])
  status              String               @default("OPEN") // OPEN, WAITING_USER, HANDED_OFF, CLOSED
  language            String?
  consentStatus       String               @default("UNKNOWN")
  lastIntentId        String?
  messages            WhatsappMessage[]
  intents             ConversationIntent[]
  quoteLinks          QuoteRequestLink[]
  handoffs            HumanHandoff[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([accountId, contactId, status])
  @@index([contactId, updatedAt])
}

model WhatsappMessage {
  id                    String                @id @default(uuid())
  conversationId        String
  conversation           WhatsappConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  providerMessageId     String?               @unique
  direction             String                // INBOUND, OUTBOUND
  messageType           String                // TEXT, IMAGE, LOCATION, CONTACT, INTERACTIVE, SYSTEM
  text                  String?
  mediaUrl               String?
  mediaMimeType         String?
  latitude              Float?
  longitude             Float?
  providerStatus        String?
  rawPayloadRef         String?               // Pointer to encrypted storage, not public credentials.
  sentAt                DateTime?
  createdAt             DateTime              @default(now())

  @@index([conversationId, createdAt])
}

model ConversationIntent {
  id                    String                @id @default(uuid())
  conversationId        String
  conversation           WhatsappConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sourceMessageId       String?
  intentJson             Json
  confidence             Float
  outcome               String                // SEARCH, ASK_FOLLOW_UP, QUOTE_REQUEST, HUMAN_HANDOFF, NO_MATCH
  clarificationQuestion String?
  createdAt             DateTime              @default(now())

  @@index([conversationId, createdAt])
}

model QuoteRequestLink {
  id             String                @id @default(uuid())
  conversationId String
  quoteRequestId String
  conversation   WhatsappConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  quoteRequest   QuoteRequest          @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  relationType   String                @default("CREATED_FROM_WHATSAPP")
  createdAt      DateTime              @default(now())

  @@unique([conversationId, quoteRequestId])
}

model HumanHandoff {
  id             String                @id @default(uuid())
  conversationId String
  conversation   WhatsappConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  reason         String                // LOW_CONFIDENCE, USER_REQUESTED, NO_MATCH, POLICY, ERROR
  status         String                @default("REQUESTED") // REQUESTED, ASSIGNED, ACTIVE, RESOLVED
  assignedTo     String?
  note           String?
  requestedAt    DateTime              @default(now())
  resolvedAt     DateTime?

  @@index([status, requestedAt])
}

model SearchEvent {
  id                 String   @id @default(uuid())
  rawQuery           String
  normalizedQuery    String
  resultCount        Int      @default(0)
  isZeroResult       Boolean  @default(false)
  sessionKey         String?
  userAgentHash      String?
  selectedBusinessId String?
  selections         SearchSelection[]
  createdAt          DateTime @default(now())
  @@index([normalizedQuery, createdAt])
  @@index([isZeroResult, createdAt])
}

model SearchSelection {
  id            String      @id @default(uuid())
  searchEventId String
  searchEvent   SearchEvent @relation(fields: [searchEventId], references: [id], onDelete: Cascade)
  businessId    String
  createdAt     DateTime    @default(now())
  @@index([businessId, createdAt])
}

model SearchLearningSuggestion {
  id               String   @id @default(uuid())
  normalizedQuery  String
  suggestedAlias   String?
  interactions     Int      @default(0)
  uniqueSessions   Int      @default(0)
  confidenceScore  Float    @default(0)
  status           String   @default("PENDING")
  reviewerNote     String?
  reviewedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@unique([normalizedQuery, suggestedAlias])
  @@index([status, confidenceScore])
}

model BusinessProject {
  id                 String   @id @default(uuid())
  businessId         String
  business            Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ownerId             String
  titleEn             String
  titleAr             String?
  descriptionEn      String?
  descriptionAr      String?
  categoryTaxonomyId String?
  serviceTaxonomyId  String?
  projectDate        DateTime?
  areaLabel          String?
  status              String   @default("DRAFT")
  media              BusinessMediaAsset[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  @@index([businessId, status, projectDate])
}

model BusinessUpdate {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ownerId     String
  titleEn     String
  titleAr     String?
  bodyEn      String
  bodyAr      String?
  status      String   @default("DRAFT")
  publishedAt DateTime?
  media       BusinessMediaAsset[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([businessId, status, publishedAt])
}

model BusinessMediaAsset {
  id                 String          @id @default(uuid())
  businessId         String
  business            Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  projectId          String?
  project            BusinessProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  updateId           String?
  update             BusinessUpdate? @relation(fields: [updateId], references: [id], onDelete: Cascade)
  uploadedBy         String
  provider            String          @default("PENDING_PROVIDER")
  storageKey         String
  publicUrl          String?
  contentType        String
  fileSize           Int
  usageType          String          @default("GALLERY")
  altText            String?
  sortOrder          Int             @default(0)
  permissionConfirmed Boolean         @default(false)
  status             String          @default("DRAFT")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  reports            BusinessMediaReport[]
  @@index([businessId, status, usageType])
}

model BusinessMediaReport {
  id          String             @id @default(uuid())
  businessId  String
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  mediaId    String
  media      BusinessMediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  reporterId String?
  reason     String
  details    String?
  status     String             @default("OPEN")
  reviewerNote String?
  reviewedAt DateTime?
  createdAt  DateTime           @default(now())
  @@index([status, createdAt])
}
