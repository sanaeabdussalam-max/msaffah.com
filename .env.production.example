# MASFAH production template — copy to /etc/masfah/masfah.env on the UAE host.
# Never commit the real file and never expose these values through NEXT_PUBLIC_*.
NODE_ENV=production
APP_HOST=127.0.0.1
APP_PORT=3000
CANONICAL_HOST=msaffah.ae
ALLOWED_HOSTS=msaffah.ae,mosaffah.ae,icad.ae

# Supabase Mumbai is for Beta/testing only until UAE PostgreSQL is approved.
# Production deployment must replace these with the approved UAE PostgreSQL URLs.
DATABASE_URL=postgresql://<runtime-user>:<password>@<private-db-host>:5432/<database>?connection_limit=5
DIRECT_URL=postgresql://<migration-user>:<password>@<private-db-host>:5432/<database>

# Generate long random values outside the repository.
MASFAH_ADMIN_API_TOKEN=<server-only-admin-token>
MASFAH_BACKUP_KEY=<server-only-export-key>

# Backup job values; the key file must be readable only by the backup service user.
MASFAH_BACKUP_DIR=/var/backups/masfah
MASFAH_BACKUP_KEY_FILE=/etc/masfah/backup.key
